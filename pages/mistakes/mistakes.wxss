/* pages/mistakes/mistakes.wxss */
.head-card .row.between {
  align-items: flex-start;
}

.head-badge {
  background: #fdecec;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  display: flex;
  align-items: baseline;
}

.head-badge-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #e5484d;
}

.head-badge-unit {
  font-size: 22rpx;
  color: #e5484d;
  margin-left: 4rpx;
}

.head-actions {
  margin-top: 24rpx;
}

.mini-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f3f5fa;
  color: #5a6478;
  font-size: 26rpx;
}

.mini-btn + .mini-btn {
  margin-left: 16rpx;
}

.mini-btn.primary {
  background: linear-gradient(135deg, #5b86ff, #3d6bff);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(61, 107, 255, 0.24);
}

/* ---------- 分类 ---------- */
.tabs {
  margin-top: 24rpx;
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 10rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 39, 51, 0.06);
}

.tab {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 27rpx;
  color: #5a6478;
  border-radius: 14rpx;
}

.tab.on {
  background: #eef2ff;
  color: #3d6bff;
  font-weight: 600;
}

.tab-num {
  font-size: 22rpx;
  margin-left: 6rpx;
  color: #98a1b3;
}

.tab.on .tab-num {
  color: #3d6bff;
}

/* ---------- 科目 ---------- */
.chips {
  margin-top: 20rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5a6478;
  font-size: 25rpx;
  margin-right: 14rpx;
}

.chip.on {
  background: #3d6bff;
  color: #ffffff;
}

/* ---------- 列表 ---------- */
.q-item {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 39, 51, 0.06);
}

.q-head {
  flex-wrap: wrap;
}

.q-head .tag {
  margin-right: 10rpx;
}

.q-wrong {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 600;
  color: #e5484d;
}

.q-stem {
  margin-top: 18rpx;
  font-size: 29rpx;
  line-height: 44rpx;
  color: #1f2733;
}

.q-answer {
  margin-top: 14rpx;
}

.q-answer-label {
  font-size: 24rpx;
  color: #8a93a6;
  margin-right: 12rpx;
}

.q-answer-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #16a34a;
}

.q-meta {
  margin-top: 14rpx;
}

.q-actions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f1f3f7;
}

.act {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #f3f5fa;
  color: #5a6478;
  font-size: 25rpx;
}

.act + .act {
  margin-left: 12rpx;
}

.act.primary {
  background: #eef2ff;
  color: #3d6bff;
}

.act:active {
  opacity: 0.8;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: #e8f8ef;
  color: #16a34a;
  font-size: 44rpx;
}

.empty-btn {
  margin-top: 28rpx;
  width: 320rpx;
  height: 76rpx;
  font-size: 28rpx;
}

.foot-tip {
  margin-top: 28rpx;
  text-align: center;
}
