<!--pages/mistakes/mistakes.wxml-->
<view class="page mistakes">
  <!-- 概览 -->
  <view wx:if="{{!protectedMode}}" class="card head-card">
    <view class="row between">
      <view>
        <view class="card-title">{{protectedEnabled ? '普通练习错题' : '错题本'}}</view>
        <view class="card-sub">共 {{counts.all}} 道错题 · {{counts.stubborn}} 道顽固 · {{counts.due}} 道待复习</view>
      </view>
      <view class="head-badge">
        <text class="head-badge-num">{{counts.all}}</text>
        <text class="head-badge-unit">题</text>
      </view>
    </view>
    <view class="row head-actions">
      <view class="mini-btn" bindtap="redoDue">练待复习</view>
      <view class="mini-btn" bindtap="redoStubborn">练顽固</view>
      <view class="mini-btn primary" bindtap="redoAll">全部重练</view>
    </view>
  </view>

  <view wx:if="{{protectedEnabled}}" class="card protected-card">
    <view class="card-title">受保护练习错题</view>
    <view class="card-sub">当前考试已确认的历史错题{{protectedLoaded ? ' · 共 ' + protectedWrongCount + ' 道' : ''}}；待同步作答不计入。</view>
    <view wx:if="{{protectedBusy}}" class="small muted">正在读取学习记录…</view>
    <view wx:if="{{protectedError}}" class="protected-error">{{protectedError}} <text bindtap="refreshProtected">重试</text></view>
    <view wx:if="{{protectedLoaded}}" class="row protected-actions">
      <text data-tab="all" bindtap="protectedTabChange">错题 {{protectedCounts.all}}</text>
      <text data-tab="due" bindtap="protectedTabChange">待复习 {{protectedCounts.due}}</text>
      <text data-tab="starred" bindtap="protectedTabChange">收藏 {{protectedCounts.starred}}</text>
      <text data-tab="mastered" bindtap="protectedTabChange">已掌握 {{protectedCounts.mastered}}</text>
    </view>
    <view wx:if="{{protectedLoaded && !protectedWrongs.length}}" class="small muted">当前分类暂无记录。</view>
    <view wx:for="{{protectedWrongs}}" wx:key="key" class="protected-row">
      <view class="row between"><text class="strong">{{item.label}}</text><text class="small muted">错 {{item.wrong}} 次 / 答 {{item.attempts}} 次</text></view>
      <view class="small muted">{{item.subjectLabel}} · {{item.chapterLabel}}</view>
      <view class="small muted">{{item.mastered ? '已掌握' : (item.due ? '待复习' : (item.wrong ? '未到复习时间' : '已收藏'))}}</view>
      <view class="row protected-actions"><text data-key="{{item.key}}" bindtap="showProtectedQuestion">查看题目</text><text wx:if="{{protectedPracticeEnabled}}" data-key="{{item.key}}" bindtap="redoProtected">{{item.due ? '复习' : '重练'}}</text></view>
      <view class="row protected-actions"><text data-key="{{item.key}}" data-field="starred" bindtap="setProtectedMarker">{{item.starred ? '取消收藏' : '收藏'}}</text><text data-key="{{item.key}}" data-field="mastered" bindtap="setProtectedMarker">{{item.mastered ? '取消掌握' : '标记掌握'}}</text></view>
    </view>
    <view wx:if="{{protectedHasMore}}" class="protected-more" bindtap="showMoreProtected">显示更多</view>
    <view wx:if="{{protectedQuestionBusy}}" class="small muted">正在校验权限并读取题目…</view>
    <view wx:if="{{protectedQuestionError}}" class="protected-error">{{protectedQuestionError}}</view>
    <view wx:if="{{protectedQuestion}}" class="protected-detail">
      <view class="row between"><text class="strong">题目详情</text><text bindtap="closeProtectedQuestion">收起</text></view>
      <view wx:if="{{protectedQuestion.updated}}" class="small muted">题目已更新，当前展示最新版本。</view>
      <view class="protected-stem">{{protectedQuestion.stem}}</view>
      <view wx:for="{{protectedQuestion.options}}" wx:key="key" class="small">{{item.key}}. {{item.text}}</view>
      <view class="small">正确答案：{{protectedQuestion.answerText}}</view>
      <view class="small muted">解析：{{protectedQuestion.explain || '暂无解析'}}</view>
    </view>
  </view>

  <!-- 分类 -->
  <view wx:if="{{!protectedMode}}" class="tabs">
    <view
      class="tab {{tab === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTab"
    >
      {{item.label}}<text class="tab-num">{{item.count}}</text>
    </view>
  </view>

  <!-- 科目筛选（科目为全应用统一口径，切换后将影响刷题 / 学情 / AI 建议） -->
  <scroll-view wx:if="{{!protectedMode}}" class="chips" scroll-x>
    <view
      class="chip {{subject === item.name ? 'on' : ''}}"
      wx:for="{{subjects}}"
      wx:key="name"
      data-subject="{{item.name}}"
      bindtap="onSubjectChange"
    >{{item.label || item.name}}</view>
  </scroll-view>

  <!-- 列表 -->
  <view wx:if="{{!protectedMode}}" class="q-item" wx:for="{{list}}" wx:key="id">
    <view class="row q-head">
      <text class="tag tag-gray">{{item.subjectLabel}}</text>
      <text class="tag">{{item.chapterLabel}}</text>
      <text class="tag tag-gray">{{item.typeName}}</text>
      <text class="q-wrong">错 {{item.wrong}} 次</text>
    </view>

    <view class="q-stem ellipsis-2">{{item.stem}}</view>

    <view class="row q-answer">
      <text class="q-answer-label">正确答案</text>
      <text class="q-answer-text">{{item.answerText}}</text>
    </view>

    <view class="row q-meta">
      <text class="small muted grow">{{item.levelText}} · 答 {{item.attempts}} 次 / 对 {{item.right}} 次 · {{item.lastText}}</text>
      <text class="tag tag-orange" wx:if="{{item.due}}">待复习</text>
    </view>

    <view class="row q-actions">
      <view class="act" data-id="{{item.id}}" bindtap="onRedo">重练</view>
      <view class="act" data-id="{{item.id}}" bindtap="onAi">AI 讲解</view>
      <view class="act" data-id="{{item.id}}" bindtap="onStar">{{item.starred ? '取消收藏' : '收藏'}}</view>
      <view class="act primary" data-id="{{item.id}}" bindtap="onMaster">已掌握</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!protectedMode && !total}}">
    <view class="empty-icon">✓</view>
    <view class="empty-title">{{protectedEnabled ? '当前科目暂无普通练习错题' : emptyTip}}</view>
    <view class="btn btn-primary btn-round empty-btn" bindtap="goPractice">去刷一组新题</view>
  </view>

  <view class="foot-tip small muted" wx:if="{{!protectedMode && total}}">连续答对可提升掌握等级，标记「已掌握」后移出本页</view>
</view>
