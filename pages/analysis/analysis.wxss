/* pages/analysis/analysis.wxss */
.hero-card .row.between {
  align-items: flex-start;
}

.rate-badge {
  background: #eef2ff;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  display: flex;
  align-items: baseline;
}

.rate-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d6bff;
}

.rate-unit {
  font-size: 22rpx;
  color: #3d6bff;
  margin-left: 4rpx;
}

.hero-bar {
  margin-top: 24rpx;
}

/* ---------- 数据条 ---------- */
.stat-row {
  margin-top: 24rpx;
  display: flex;
  flex-direction: row;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 28rpx rgba(31, 39, 51, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item + .stat-item {
  border-left: 2rpx solid #f1f3f7;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2733;
}

.stat-num.bad {
  color: #e5484d;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a93a6;
}

/* ---------- 图表 ---------- */
.chart-card {
  margin-top: 24rpx;
}

.chart {
  width: 100%;
  display: block;
}

.radar-chart {
  height: 440rpx;
  margin-top: 8rpx;
}

.trend-chart {
  height: 360rpx;
  margin-top: 16rpx;
}

.bars-chart {
  height: 300rpx;
  margin-top: 16rpx;
}

.legend {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.legend-item {
  width: 50%;
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 24rpx;
  color: #5a6478;
  padding: 6rpx 0;
}

.legend-value {
  color: #3d6bff;
  font-weight: 600;
  margin-left: 10rpx;
}

/* ---------- 每日明细 ---------- */
.trend-table {
  margin-top: 20rpx;
}

.trend-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 14rpx;
}

.trend-date {
  width: 88rpx;
  font-size: 23rpx;
  color: #8a93a6;
}

.trend-bar {
  flex: 1;
  margin: 0 16rpx;
}

.trend-value {
  width: 76rpx;
  text-align: right;
  font-size: 23rpx;
  color: #5a6478;
}

/* ---------- 模块列表 ---------- */
.chapter-list {
  margin-top: 20rpx;
}

.chapter-item {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
  margin-bottom: 16rpx;
}

.chapter-item:last-child {
  margin-bottom: 0;
}

.chapter-bar {
  margin-top: 14rpx;
}

.chapter-meta {
  margin-top: 12rpx;
}

/* ---------- 薄弱 / 优势 ---------- */
.weak-list {
  margin-top: 20rpx;
}

.weak-item {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff8f8;
  margin-bottom: 16rpx;
}

.weak-item:last-child {
  margin-bottom: 0;
}

.weak-btn {
  margin-top: 20rpx;
  height: 76rpx;
  font-size: 28rpx;
}

.strong-list {
  margin-top: 20rpx;
}

.strong-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f4fbf7;
  margin-bottom: 14rpx;
  font-size: 27rpx;
}

.strong-item:last-child {
  margin-bottom: 0;
}

/* ---------- 顽固错题 ---------- */
.stubborn-list {
  margin-top: 20rpx;
}

.stubborn-item {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
  margin-bottom: 16rpx;
}

.stubborn-item:last-child {
  margin-bottom: 0;
}

.stubborn-stem {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #1f2733;
}

.stubborn-actions {
  margin-top: 16rpx;
}

.act {
  flex: 1;
  height: 62rpx;
  line-height: 62rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #eceff5;
  color: #5a6478;
  font-size: 25rpx;
}

.act + .act {
  margin-left: 14rpx;
}

.act.primary {
  background: #eef2ff;
  color: #3d6bff;
}

.act:active {
  opacity: 0.8;
}

/* ---------- AI 建议 ---------- */
.ai-card {
  margin-top: 24rpx;
}

.ai-logo {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6f9bff, #3d6bff);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 18rpx;
}

.ai-list {
  margin-top: 20rpx;
}

.ai-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.ai-item:last-child {
  margin-bottom: 0;
}

.ai-dot {
  color: #3d6bff;
  margin-right: 10rpx;
  line-height: 40rpx;
}

.ai-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #4a5364;
}

/* ---------- 空状态 ---------- */
.empty-icon {
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  border-radius: 50%;
  background: #eef2ff;
  color: #3d6bff;
  font-size: 46rpx;
}

.empty-btn {
  margin-top: 28rpx;
  width: 340rpx;
  height: 76rpx;
  font-size: 28rpx;
}
