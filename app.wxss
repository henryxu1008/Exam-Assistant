/** app.wxss —— 全局样式 */
page {
  background: #f5f7fb;
  color: #1f2733;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  padding: 24rpx 24rpx 40rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.wrap {
  flex-wrap: wrap;
}

.grow {
  flex: 1;
}

.center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 39, 51, 0.06);
}

.card + .card {
  margin-top: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2733;
}

.card-sub {
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}

/* ---------- 文字 ---------- */
.muted {
  color: #8a93a6;
}

.small {
  font-size: 24rpx;
}

.mid {
  font-size: 28rpx;
}

.big {
  font-size: 40rpx;
  font-weight: 700;
}

.strong {
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eef2ff;
  color: #3d6bff;
}

.tag-gray {
  background: #f1f3f7;
  color: #767f92;
}

.tag-green {
  background: #e8f8ef;
  color: #16a34a;
}

.tag-orange {
  background: #fff3e6;
  color: #f28b30;
}

.tag-red {
  background: #fdecec;
  color: #e5484d;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  background: #ffffff;
  color: #3d6bff;
  border: 2rpx solid #d9e1ff;
}

.btn-primary {
  background: linear-gradient(135deg, #5b86ff, #3d6bff);
  color: #ffffff;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(61, 107, 255, 0.28);
}

.btn-ghost {
  background: #f3f5fa;
  color: #5a6478;
  border: none;
}

.btn-block {
  width: 100%;
}

.btn-round {
  border-radius: 999rpx;
}

.btn:active {
  opacity: 0.85;
}

/* ---------- 列表项 ---------- */
.list-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.list-item + .list-item {
  margin-top: 16rpx;
}

/* ---------- 进度条 ---------- */
.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #eef1f6;
  overflow: hidden;
}

.bar-inner {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6f9bff, #3d6bff);
  transition: width 0.3s;
}

.bar-inner.red {
  background: linear-gradient(90deg, #ff8a80, #e5484d);
}

.bar-inner.orange {
  background: linear-gradient(90deg, #ffc36b, #f28b30);
}

.bar-inner.green {
  background: linear-gradient(90deg, #6ee7a5, #16a34a);
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8a93a6;
  font-size: 26rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #5a6478;
  margin-top: 16rpx;
}

/* ---------- 安全区 ---------- */
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
